{
    "archive-current-only": false,
    "concurrency": {
        "rss-downloads": 2,
        "webpage-downloads": 8
    },
    "rss": {
        "change-detection": {
            "ignore-tags": [
                "lastBuildDate"
            ]
        }
    },
    "webpages": {
        "storage-path": "pages",
        "refresh-policy": "always"
    },
    "downloaders": {
        "default": {
            "options": {
                "use-session": true,
                "timeout": 30,
                "retries": 3,
                "backoff-factor": 0.5,
                "verify-tls": true,
                "user-agent": {
                    "strategy": "per-run"
                }
            }
        },
        "rotating": {
            "backend": "requests",
            "concurrency": {
                "rss-downloads": 1,
                "webpage-downloads": 2
            },
            "options": {
                "use-session": false,
                "user-agent": {
                    "strategy": "per-request"
                }
            }
        }
    },
    "feeds": [
        {
            "url": "https://example.com/rss.xml"
        },
        {
            "url": "https://example.org/rss.xml",
            "download-webpages": true,
            "webpage-refresh-policy": "on-rss-change"
        },
        {
            "url": "https://example.net/rss.xml",
            "rss-downloader": "default",
            "download-webpages": true,
            "webpage-downloader": "rotating",
            "webpage-refresh-policy": "missing-only",
            "change-detection": {
                "ignore-tags": []
            }
        }
    ]
}
